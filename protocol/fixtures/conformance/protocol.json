    {
      "id": "protocol.protected-resource-trailing-slash",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "PAP-3.2-04"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.fr",
        "responses": {
          "https://example.fr/.well-known/poppy.json": {
            "status": 200,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example FR",
                "domain": "example.fr"
              },
              "auth": {
                "issuer": "https://auth.example.com"
              },
              "web": {}
            }
          },
          "https://auth.example.com/.well-known/oauth-authorization-server": {
            "status": 200,
            "json": {
              "issuer": "https://auth.example.com",
              "token_endpoint": "https://auth.example.com/oauth/token",
              "revocation_endpoint": "https://auth.example.com/oauth/revoke",
              "protected_resources": [
                "https://example.fr/"
              ],
              "grant_types_supported": [
                "urn:ietf:params:oauth:grant-type:jwt-bearer",
                "refresh_token"
              ]
            }
          }
        }
      },
      "expect": {
        "error": "domain_not_authorized"
      },
      "description": "An entry with a trailing slash does not match: resources compare as exact strings (§3.2, RFC 9728 §3.3)."
    },
