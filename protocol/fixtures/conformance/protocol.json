      "input": {
        "domain": "www.example.com",
        "responses": {
          "https://www.example.com/.well-known/poppy.json": {
            "status": 200,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "web": {}
            }
          }
        }
      },
      "expect": {
        "error": "organization_domain_mismatch"
      },
      "description": "organization.domain is the host that served the document, compared ignoring case only: a leading www. is not ignored (§3.1)."
    },
    {
      "id": "protocol.organization-domain-after-redirect",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "PAP-3.1-02",
        "PAP-3-02"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 302,
            "headers": {
              "location": "https://host.provider.example/.well-known/poppy.json"
            }
          },
          "https://host.provider.example/.well-known/poppy.json": {
            "status": 200,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "web": {}
            }
          }
        }
      },
      "expect": {
        "error": "organization_domain_mismatch"
      },
      "description": "A document speaks for the host that serves it after redirects: one served by a provider's host can't name the company's domain (§3, §3.1)."
    },
    {
      "id": "protocol.redirect-ends-off-the-well-known-path",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "PAP-3-11"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 302,
            "headers": {
              "location": "https://example.com/uploads/poppy.json"
            }
          },
          "https://example.com/uploads/poppy.json": {
            "status": 200,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "web": {}
            }
          }
        }
      },
      "expect": {
        "error": "invalid_discovery_location"
      },
      "description": "A redirect may change host, but only a document at /.well-known/poppy.json, with no query, speaks for a domain: an upload elsewhere on it does not (§3, §9.3)."
    },
    {
      "id": "protocol.redirect-ends-with-a-query",
