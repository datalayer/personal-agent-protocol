              ],
              "grant_types_supported": [
                "urn:ietf:params:oauth:grant-type:jwt-bearer",
                "refresh_token"
              ]
            }
          }
        }
      },
      "expect": {
        "issuer": "https://auth.provider.example/shop-a"
      }
    },
    {
      "id": "protocol.dpop-algorithms-include-es256",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "PAP-3.2-10"
      ],
      "check": "discovery",
      "description": "A company that lists dpop_signing_alg_values_supported includes ES256 (§3.2); metadata without it is refused.",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 200,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "auth": {
                "issuer": "https://auth.example.com"
              },
              "web": {}
            }
          },
          "https://auth.example.com/.well-known/oauth-authorization-server": {
            "status": 200,
            "json": {
              "issuer": "https://auth.example.com",
              "token_endpoint": "https://auth.example.com/oauth/token",
              "revocation_endpoint": "https://auth.example.com/oauth/revoke",
              "dpop_signing_alg_values_supported": [
                "RS256"
              ],
              "protected_resources": [
                "https://example.com"
              ],
              "grant_types_supported": [
                "urn:ietf:params:oauth:grant-type:jwt-bearer",
                "refresh_token"
              ]
            }
          }
        }
      },
