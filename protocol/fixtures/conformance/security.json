      "description": "A delegation past its exp (§5.2).",
      "target": "session_jwt",
      "mutation": {
        "delegation_iat_offset": -7200,
        "delegation_lifetime": 3600
      },
      "expect": {
        "status": 400,
        "error": "invalid_session"
