{
  "suite": "security",
  "profile": "0.3",
  "description": "Duplicate JSON members, SSRF, redirects, oversized metadata, JOSE algorithm confusion, audiences, clock skew, replay, and DPoP mismatches.",
  "cases": [
    {
      "id": "security.duplicate-json-members",
      "kind": "negative",
      "role": "both",
      "requirements": [
        "GUIDE-json-01"
      ],
      "check": "strict_json",
      "input": [
        "{\"issuer\":\"https://a.example\",\"issuer\":\"https://b.example\"}",
        "{\"auth\":{\"issuer\":\"x\",\"issuer\":\"y\"}}",
        "[{\"id\":\"evt_1\",\"id\":\"evt_2\"}]",
        "{\"a\":1,\"\\u0061\":2}"
      ],
      "expect": {
        "error": "duplicate_json_member"
      }
    },
    {
      "id": "security.ssrf-loopback",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "127.0.0.1"
        ]
      },
      "expect": {
        "error": "unsafe_address"
      }
    },
    {
      "id": "security.ssrf-private",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "10.0.0.7"
        ]
      },
      "expect": {
        "error": "unsafe_address"
      }
    },
    {
      "id": "security.ssrf-link-local-metadata",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "169.254.169.254"
        ]
      },
      "expect": {
        "error": "unsafe_address"
      }
    },
    {
      "id": "security.ssrf-ipv6-loopback-and-unique-local",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "::1",
          "fd00::5"
        ]
      },
      "expect": {
        "error": "unsafe_address"
      }
    },
    {
      "id": "security.ssrf-ipv4-mapped",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "::ffff:127.0.0.1"
        ]
      },
      "expect": {
        "error": "unsafe_address"
      }
    },
    {
      "id": "security.dns-rebinding-mixed-answers",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "93.184.216.34",
          "192.168.1.1"
        ]
      },
      "expect": {
        "error": "unsafe_address"
      }
    },
    {
      "id": "security.dns-rebinding-after-check",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "description": "The host resolves to a public address when checked, then to loopback: the connection goes to the checked address, and the host is never resolved again.",
      "sdk": [
        "python"
      ],
      "check": "pinned_connect",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "answers": [
          [
            "93.184.216.34"
          ],
          [
            "127.0.0.1"
          ]
        ]
      },
      "expect": {
        "connects_to": [
          "93.184.216.34"
        ],
        "resolutions": 1
      }
    },
    {
      "id": "security.public-address-allowed",
      "kind": "positive",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-03"
      ],
      "check": "url_safety",
      "input": {
        "url": "https://company.example/.well-known/poppy.json",
        "addresses": [
          "93.184.216.34"
        ]
      },
      "expect": {
        "safe": true
      }
    },
    {
      "id": "security.discovery-redirect-to-http",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "PAP-3-03"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 301,
            "headers": {
              "location": "http://example.com/poppy.json"
            }
          }
        }
      },
      "expect": {
        "error": "unsafe_url"
      }
    },
    {
      "id": "security.discovery-redirect-followed",
      "kind": "positive",
      "role": "personal-agent",
      "requirements": [
        "PAP-3-02",
        "PAP-3-03"
      ],
      "check": "discovery",
      "input": {
        "domain": "www.example.com",
        "responses": {
          "https://www.example.com/.well-known/poppy.json": {
            "status": 302,
            "headers": {
              "location": "https://example.com/.well-known/poppy.json"
            }
          },
          "https://example.com/.well-known/poppy.json": {
            "status": 200,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "web": {}
            }
          }
        }
      },
      "expect": {
        "organization_domain": "example.com",
        "discovery_url": "https://example.com/.well-known/poppy.json"
      }
    },
    {
      "id": "security.discovery-redirect-limit",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-01"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 302,
            "headers": {
              "location": "https://example.com/r1"
            }
          },
          "https://example.com/r1": {
            "status": 302,
            "headers": {
              "location": "https://example.com/r2"
            }
          },
          "https://example.com/r2": {
            "status": 302,
            "headers": {
              "location": "https://example.com/r3"
            }
          },
          "https://example.com/r3": {
            "status": 302,
            "headers": {
              "location": "https://example.com/r4"
            }
          },
          "https://example.com/r4": {
            "status": 200,
            "json": {}
          }
        }
      },
      "expect": {
        "error": "too_many_redirects"
      }
    },
    {
      "id": "security.oversized-metadata",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-01"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 200,
            "padding_bytes": 102401,
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "web": {}
            }
          }
        }
      },
      "expect": {
        "error": "response_too_large"
      }
    },
    {
      "id": "security.slow-metadata",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-01"
      ],
      "description": "The server sends the document a few bytes at a time, each read well within any read timeout: the fetch is abandoned when its total time limit passes.",
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "timeout_seconds": 0.3,
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 200,
            "trickle": {
              "chunk_bytes": 8,
              "interval_seconds": 0.05
            },
            "json": {
              "protocol_version": "0.3",
              "organization": {
                "name": "Example",
                "domain": "example.com"
              },
              "web": {}
            }
          }
        }
      },
      "expect": {
        "error": "metadata_timeout"
      }
    },
    {
      "id": "security.metadata-not-json",
      "kind": "negative",
      "role": "personal-agent",
      "requirements": [
        "GUIDE-fetch-01"
      ],
      "check": "discovery",
      "input": {
        "domain": "example.com",
        "responses": {
          "https://example.com/.well-known/poppy.json": {
            "status": 200,
            "content_type": "text/html",
            "text": "<html></html>"
          }
        }
      },
      "expect": {
        "error": "invalid_content_type"
      }
    },
