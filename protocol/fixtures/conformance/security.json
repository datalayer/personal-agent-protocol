      "id": "security.session-jwt-wrong-signature",
      "kind": "negative",
      "role": "company",
      "requirements": [
        "PAP-4.3-02"
      ],
      "description": "A Session JWT whose signature doesn't verify with its delegated key (§5.2).",
      "target": "session_jwt",
      "mutation": {
        "tamper_signature": true
      },
      "expect": {
        "status": 400,
        "error": "invalid_session"
      }
    },
    {
      "id": "security.session-jwt-wrong-typ",
      "kind": "negative",
      "role": "company",
      "requirements": [
