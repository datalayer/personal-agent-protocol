{
  "name": "user-with-a-company",
  "description": "A user with a company, one journey for every language pairing: discovery, a signed-out Session, a question that needs signing in, Direct Sign-In, an API read, the conversation continued, and an operation confirmed once.",
  "company": {
    "domain": "manzanita.example",
    "name": "Manzanita Outfitters",
    "account_id": "acct_ada"
  },
  "agent": {
    "domain": "atlas.example",
    "name": "Atlas",
    "tenant_id": "atlas-demo",
    "pairwise_user_id": "usr_ada_at_manzanita_000000",
    "redirect_path": "/oauth/callback"
  },
  "steps": [
    { "step": "discover", "expect": { "organization": "Manzanita Outfitters", "operations": true } },
    { "step": "session", "expect": { "signed_in": false } },
    {
      "step": "ask",
      "text": "Where is my jacket order?",
      "expect": { "events": ["message", "message", "authorization"], "error": "sign_in_required" }
    },
    {
      "step": "sign_in",
      "method": "direct",
      "scopes": ["orders:read", "orders:write"],
      "expect": { "signed_in": true, "granted": ["orders:read", "orders:write"], "consent_page": ["Atlas", "atlas.example", "See your orders"] }
    },
    {
      "step": "api_read",
      "method": "GET",
      "path": "/api/orders",
      "expect": { "status": 200, "body": { "orders": [{ "order_id": "ord_7Hk2", "item": "Ridge Jacket, size M", "status": "delivered" }] } }
    },
    {
      "step": "continue",
      "text": "Exchange it for something warmer",
      "expect": { "operation_state": "proposed", "user_approval_required": true }
    },
    {
      "step": "confirm",
      "approved_by": "user",
      "times": 2,
      "expect": { "state": "succeeded", "summary_starts_with": "Exchanged the Ridge Jacket", "performed": 1 }
    }
  ]
}
